# คัดลอกไฟล์นี้เป็น mobile/android/.env แล้วแก้ค่า (.env ถูก .gitignore ไว้ ไม่ขึ้น Git)
# ที่อยู่ RAN MOBILE Server ที่แอปจะเชื่อมตอน build (BuildConfig.SERVER_URL)
#   debug (อีมูเลเตอร์ Android → เครื่อง host):  http://10.0.2.2:8080
#   release (ต้องเป็น https เท่านั้น):          https://ran-mobile.example.com
RAN_SERVER_URL=http://10.0.2.2:8080

# ห้ามใส่รหัสผ่าน keystore หรือ private key ในไฟล์นี้
# ค่า signing ใส่ใน ~/.gradle/gradle.properties เท่านั้น (ดู docs/ANDROID_BUILD.md)
