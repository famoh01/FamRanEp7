# Copy to keystore.properties (git-ignored) and fill in your own values, or run
#   scripts/make_test_keystore.sh
# which writes this file for a throw-away test key. Never commit the keystore or the passwords.
ranKeystoreFile=/absolute/path/to/ran-mobile-release.jks
ranKeystorePassword=change-me
ranKeyAlias=ran-mobile
ranKeyPassword=change-me
